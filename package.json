{
  "name": "fit-file-viewer-readable",
  "version": "0.0.0",
  "private": true,
  "description": "Local FIT file viewer with tables, charts, maps and exports",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "test:rewrite": "pnpm test",
    "typecheck": "tsc --noEmit",
    "audit:source": "tsx scripts/audit-source.ts",
    "bench:rewrite": "tsx scripts/benchmark-rewrite.ts",
    "bench:motion": "tsx scripts/benchmark-motion.ts",
    "bench:motion:worker": "tsx scripts/benchmark-motion-worker.ts",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "notices": "tsx scripts/collect-notices.ts",
    "verify:downloads": "tsx scripts/verify-downloads.ts",
    "test:browser:report": "tsx scripts/check-browser-report.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:desktop": "vite build --base ./ && node scripts/build-electron.mjs",
    "desktop": "electron desktop/main.cjs",
    "package:desktop": "electron-builder --config electron-builder.json --publish never",
    "test:desktop": "node scripts/smoke-electron.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@garmin/fitsdk": "21.205.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-switch": "^1.2.0",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "^3.9.9",
    "semver": "7.8.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "yaml": "2.9.1"
  }
}
